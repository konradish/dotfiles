#!/usr/bin/env bash
# Block commits containing credentials.
#
# This repo is PUBLIC. It has twice come within one `git add -A` of publishing
# live API keys, so this hook is the last line of defence before history.
#
# Versioned in .githooks/ (not .git/hooks/) and activated by
#   git config core.hooksPath .githooks
# so it survives a fresh clone. Re-run that command after cloning.
set -uo pipefail

GITLEAKS="${GITLEAKS:-$HOME/.local/bin/gitleaks}"

if [ ! -x "$GITLEAKS" ]; then
  echo "pre-commit: gitleaks not found at $GITLEAKS" >&2
  echo "  install it, or set GITLEAKS=/path/to/gitleaks" >&2
  echo "  bypass once with: git commit --no-verify  (you had better be sure)" >&2
  exit 1
fi

# --staged scans only what is about to be committed; --redact keeps the secret
# itself out of the terminal and out of any scrollback or session transcript.
if ! "$GITLEAKS" protect --staged --redact --no-banner; then
  echo >&2
  echo "pre-commit: BLOCKED — staged changes contain something credential-shaped." >&2
  echo "  Move it into Vaultwarden and reference it from a chezmoi template." >&2
  echo "  False positive? Add a narrow rule to .gitleaks.toml (never blanket-allow)." >&2
  exit 1
fi
