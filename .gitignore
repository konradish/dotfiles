# This repo is PUBLIC. Nothing containing a credential may be committed.

# pi agent: auth.json holds real Anthropic + Google API keys (mode 600).
# Only models.json / settings.json are safe to track.
pi/.pi/agent/auth.json
pi/.pi/agent/sessions/
pi/.pi/agent/*.bak-*

# Generic credential shapes, in case a package is added carelessly later.
**/.env
**/*.pem
**/*credentials*.json
**/.netrc

# Build noise
**/__pycache__/
*.pyc

# ~/.local is stow-linked to bin/.local, so ANY tool installed to ~/.local/bin
# lands inside this repo and shows up as a commit candidate. Text helper scripts
# there are intentional; compiled binaries are not (gitleaks alone is 21MB).
bin/.local/bin/gitleaks
bin/.local/bin/*.bin
bin/.local/lib/
bin/.local/share/
