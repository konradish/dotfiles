#!/usr/bin/env bash
# sys-resume -- undo `sys-pause`: networking on, wait for a default route and
# DNS, start Docker, wait for the recorded containers, then VERIFY the things
# that have silently broken before on this box.
#
# Usage: sys-resume [--docker-only] [--net-only] [--no-verify] [--verify-only]
#
# Verify pass (each line PASS/FAIL, exit 1 if any FAIL):
#   route/dns     default route present, external name resolves
#   tailscale     `tailscale status` reports the node online
#   containers    every container recorded by sys-pause is running again
#   gpu           `nvidia-smi -L` inside each GPU container (NVML "Unknown
#                 Error" = the reload/udev footgun; auto-fixed with a compose
#                 --force-recreate of that service, then re-checked)
#   traefik       http://traefik.localhost/api/http/routers answers
#   mcp-public    https://mcp.konradodell.com/health == 200 (Cloudflare tunnel
#                 -> cloudflared container -> gateway, end to end)
#   cf-tunnel     Cloudflare API says the koni9 tunnel is healthy (needs
#                 CLOUDFLARE_API_TOKEN in ~/.secrets.env; SKIP if absent)
set -uo pipefail

DOCKER=1; NET=1; VERIFY=1; ONLY_VERIFY=0
for a in "$@"; do
  case "$a" in
    --docker-only) NET=0 ;;
    --net-only) DOCKER=0 ;;
    --no-verify) VERIFY=0 ;;
    --verify-only) ONLY_VERIFY=1 ;;
    -h|--help) sed -n '2,22p' "$0"; exit 0 ;;
    *) echo "unknown arg: $a" >&2; exit 2 ;;
  esac
done

STATE="$HOME/.cache/sys-pause/state"
ts() { date '+%F %T'; }
FAILS=0
pass() { printf '  PASS  %-11s %s\n' "$1" "$2"; }
fail() { printf '  FAIL  %-11s %s\n' "$1" "$2"; FAILS=$((FAILS+1)); }
skip() { printf '  SKIP  %-11s %s\n' "$1" "$2"; }

wait_for() { # wait_for <seconds> <label> <cmd...>
  local n=$1 label=$2; shift 2
  for ((i=0; i<n; i++)); do "$@" >/dev/null 2>&1 && return 0; sleep 1; done
  echo "[$(ts)] timed out after ${n}s waiting for $label" >&2; return 1
}

if [ "$ONLY_VERIFY" = 0 ]; then
  if [ "$NET" = 1 ]; then
    echo "[$(ts)] networking on (nmcli)"
    nmcli networking on || true
    wait_for 60 "default route" sh -c 'ip route show default | grep -q .' || true
    wait_for 30 "external DNS" getent hosts example.com || true
    echo "[$(ts)] route: $(ip route show default | head -1)"
  fi
  if [ "$DOCKER" = 1 ]; then
    echo "[$(ts)] starting docker (socket + service)"
    sudo -n systemctl start docker.socket docker
    wait_for 60 "docker daemon" docker info || true
    if [ -f "$STATE" ]; then
      want=$(grep '^containers=' "$STATE" | cut -d= -f2)
      echo "[$(ts)] waiting for recorded containers: $want"
      for c in $want; do
        wait_for 90 "container $c" sh -c "[ \"\$(docker inspect -f '{{.State.Running}}' $c 2>/dev/null)\" = true ]" || true
      done
    fi
  fi
fi

[ "$VERIFY" = 1 ] || { echo "[$(ts)] resumed (verify skipped)"; exit 0; }

echo "[$(ts)] verify:"

# route/dns
if ip route show default | grep -q . && getent hosts example.com >/dev/null; then
  pass route/dns "$(ip route show default | head -1 | cut -c1-60)"
else
  fail route/dns "no default route or external DNS not resolving"
fi

# tailscale
if command -v tailscale >/dev/null && tailscale status --json 2>/dev/null | python3 -c 'import sys,json;d=json.load(sys.stdin);sys.exit(0 if d.get("Self",{}).get("Online") else 1)' 2>/dev/null; then
  pass tailscale "node online"
else
  fail tailscale "tailscale status does not report Self.Online"
fi

# containers
if [ -f "$STATE" ]; then
  want=$(grep '^containers=' "$STATE" | cut -d= -f2)
  missing=""
  for c in $want; do
    [ "$(docker inspect -f '{{.State.Running}}' "$c" 2>/dev/null)" = true ] || missing="$missing $c"
  done
  if [ -z "$missing" ]; then pass containers "all $(echo $want | wc -w) recorded containers running"
  else fail containers "not running:$missing"; fi
else
  skip containers "no sys-pause state file"
fi

# gpu (auto-repair once)
gpu_check() { docker exec "$1" nvidia-smi -L >/dev/null 2>&1; }
for c in $(docker ps --format '{{.Names}}'); do
  [ "$(docker inspect -f '{{len .HostConfig.DeviceRequests}}' "$c" 2>/dev/null)" != "0" ] || continue
  if gpu_check "$c"; then pass gpu "$c sees $(docker exec "$c" nvidia-smi -L 2>/dev/null | head -1 | cut -c1-40)"; continue; fi
  wd=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c")
  cf=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.config_files"}}' "$c")
  svc=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.service"}}' "$c")
  if [ -n "$wd" ] && [ -n "$svc" ]; then
    echo "  ...   gpu         $c: NVML failed -> force-recreate via compose ($svc in $wd)"
    ( cd "$wd" && docker compose -f "${cf:-compose.yml}" up -d --force-recreate --no-build "$svc" ) >/dev/null 2>&1
    sleep 5
    if gpu_check "$c"; then pass gpu "$c repaired by force-recreate"; else fail gpu "$c still cannot init NVML after recreate"; fi
  else
    fail gpu "$c cannot init NVML and has no compose labels to recreate from"
  fi
done

# traefik
if curl -s --max-time 5 http://traefik.localhost/api/http/routers | grep -q '"name"'; then
  pass traefik "$(curl -s --max-time 5 http://traefik.localhost/api/http/routers | grep -o '"name"' | wc -l) routers"
else
  fail traefik "http://traefik.localhost/api/http/routers not answering"
fi

# mcp-public (tunnel -> cloudflared -> gateway)
code=$(curl -s --max-time 15 -o /dev/null -w '%{http_code}' https://mcp.konradodell.com/health || echo 000)
if [ "$code" = 200 ]; then pass mcp-public "https://mcp.konradodell.com/health 200"
else
  # give cloudflared a moment to re-register, then retry once
  sleep 15
  code=$(curl -s --max-time 15 -o /dev/null -w '%{http_code}' https://mcp.konradodell.com/health || echo 000)
  if [ "$code" = 200 ]; then pass mcp-public "200 after retry"; else fail mcp-public "HTTP $code"; fi
fi

# cf-tunnel (API)
if [ -f "$HOME/.secrets.env" ]; then
  set -a; . "$HOME/.secrets.env" 2>/dev/null; set +a
fi
if [ -n "${CLOUDFLARE_API_TOKEN:-}" ] && command -v wrangler >/dev/null; then
  # the tunnel token is base64 JSON {"a":account,"s":secret,"t":tunnel}; decode it for both ids
  ids=$(docker inspect mcp-cloudflared-1 -f '{{json .Args}}' 2>/dev/null | python3 -c 'import sys,json,base64;a=json.load(sys.stdin);t=a[a.index("--token")+1];d=json.loads(base64.b64decode(t+"="*(-len(t)%4)));print(d["a"],d["t"])' 2>/dev/null)
  acc=${ids%% *}; tun=${ids##* }
  if [ -n "$acc" ] && [ -n "$tun" ]; then
    st=$(curl -s --max-time 15 -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" "https://api.cloudflare.com/client/v4/accounts/$acc/cfd_tunnel/$tun" | python3 -c 'import sys,json;d=json.load(sys.stdin)["result"];print(d["status"], len(d.get("connections") or []))' 2>/dev/null)
    case "$st" in healthy*) pass cf-tunnel "status=$st connections" ;; *) fail cf-tunnel "status=${st:-unreadable}" ;; esac
  else
    skip cf-tunnel "could not derive account or tunnel id"
  fi
else
  skip cf-tunnel "no CLOUDFLARE_API_TOKEN / wrangler"
fi

if [ "$FAILS" = 0 ]; then echo "[$(ts)] resumed: all checks PASS"; exit 0
else echo "[$(ts)] resumed with $FAILS FAIL(s) above"; exit 1; fi
